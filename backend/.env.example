# Real .env stays out of git. Copy this file to .env and fill in values.
# In production (Fly.io), set these via `flyctl secrets set` instead.

# --- Auth ---
# bcrypt hash of the shared password. Generate with:
#   uv run python -c "from app.auth import hash_password; print(hash_password('YOUR_PASSWORD'))"
SHARED_PASSWORD_HASH=

# 32+ bytes of randomness for signing session cookies. Generate with:
#   openssl rand -hex 32
# Never reuse the dev fallback ('dev-insecure-change-me') in production.
COOKIE_SIGNING_KEY=

# Set to true behind HTTPS (always true in production).
COOKIE_SECURE=false

# --- LLM provider ---
# 'anthropic' (default) or 'nvidia' for an OpenAI-compatible NVIDIA endpoint.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m2.7

# --- Resy (optional, for the "Check availability" button) ---
RESY_API_KEY=
RESY_AUTH_TOKEN=

# --- Rate limits (defaults shown) ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=3600
